<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Accueil{% endblock %}</title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://w3.org viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎬</text></svg>">

    {# Bootstrap en CDN (Attention : écrase les styles si votre CSS personnalisé n'est pas chargé APRES) #}
    <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
    >

    <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"
            integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"
    >

    {% block stylesheets %}
        {# Avec AssetMapper, si app.css est importé dans app.js, importmap() s'en occupe. #}
        {# Si ce n'est pas le cas, forcez le chargement de votre CSS personnalisé ICI pour qu'il passe APRES Bootstrap : #}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}

    {% block javascripts %}
        {# AssetMapper gère le point d'entrée unique de votre application JS et CSS #}
        {{ importmap('app') }}
    {% endblock %}

    {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') ?? null %}
    {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://jsdelivr.net" crossorigin="anonymous" defer></script>
    {% endif %}
</head>
<body>
    {{ include('partials/_navbar.html.twig') }}

    {% block body %}{% endblock %}

    <script
            src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.8/js/bootstrap.min.js"
            integrity="sha512-nKXmKvJyiGQy343jatQlzDprflyB5c+tKCzGP3Uq67v+lmzfnZUi/ZT+fc6ITZfSC5HhaBKUIvr/nTLCV+7F+Q=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"
    ></script>
</body>
</html>
