{% extends 'base.html.twig' %}

{% block title %}Connexion | Le Carnet Gourmand{% endblock %}

{% block body %}
    <main class="login-page">
        <section class="login-card" aria-labelledby="login-title">

            <div class="login-card__intro">
                <span class="login-card__eyebrow">BIENVENUE CHEZ VOUS</span>

                <div class="login-card__illustration" aria-hidden="true">
                    <span>✳</span>
                </div>

                <h1>Le plaisir de cuisiner commence ici.</h1>

                <p class="login-card__description">
                    Retrouvez votre espace personnel et continuez
                    à explorer les recettes qui font du quotidien
                    un moment gourmand.
                </p>

                <div class="login-card__signature">
                    <span class="login-card__signature-line"></span>
                    <span>La cuisine du quotidien</span>
                </div>
            </div>

            <div class="login-card__form">
                <div class="login-heading">
                    <span class="login-heading__label">VOTRE ESPACE</span>
                    <h2 id="login-title">Connexion</h2>
                    <p>Heureux de vous retrouver !</p>
                </div>

                {% if error is defined and error %}
                    <div class="login-alert" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {{ form_start(form, {
                    attr: {class: 'login-form'},
                }) }}

                    {{ form_errors(form) }}

                    <div class="login-form__field">
                        {{ form_label(form.email, null, {
                            label_attr: {class: 'login-form__label'},
                        }) }}

                        {{ form_widget(form.email, {
                            attr: {
                                class: 'login-form__input',
                                placeholder: 'nom@exemple.fr',
                                autocomplete: 'email',
                            },
                        }) }}

                        {{ form_errors(form.email) }}
                    </div>

                    <div
                        class="login-form__field"
                        data-controller="password-visibility"
                    >
                        {{ form_label(form.password, null, {
                            label_attr: {class: 'login-form__label'},
                        }) }}

                        <div class="password-field">
                            {{ form_widget(form.password, {
                                attr: {
                                    class: 'login-form__input',
                                    autocomplete: 'current-password',
                                    placeholder: 'Votre mot de passe',
                                    'data-password-visibility-target': 'input',
                                },
                            }) }}

                            <button
                                type="button"
                                class="password-field__toggle"
                                data-action="click->password-visibility#toggle"
                                title="Afficher le mot de passe"
                                aria-label="Afficher le mot de passe"
                            >
                                <i
                                    class="fa-solid fa-eye-slash"
                                    data-password-visibility-target="icon"
                                    aria-hidden="true"
                                ></i>
                            </button>
                        </div>

                        {{ form_errors(form.password) }}
                    </div>

                    <button type="submit" class="login-form__submit">
                        Se connecter
                    </button>

                {{ form_end(form) }}

                <p class="login-card__footer">
                    <span aria-hidden="true">✳</span>
                    Votre cuisine, vos envies, votre espace.
                </p>
            </div>

        </section>
    </main>
{% endblock %}
