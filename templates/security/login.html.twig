{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}

    <div class="login-page-flash-wrapper text-center">
        {{ include('partials/flash.html.twig') }}
    </div>

    <div class="login-page">
        <div class="login-card">
            <div class="login-logo">
                <i class="fa-solid fa-utensils"></i>
            </div>

            <h1>Back-Office</h1>

            <p class="login-subtitle">
                Connectez-vous à votre espace administrateur
            </p>

            {% if error %}
                <div class="alert alert-danger" role="alert">
                    {{ error.messageKey|trans(error.messageData, 'security')|nl2br }}
                </div>
            {% endif %}

            <form method="post">
                <div class="mb-3">
                    <label for="username" class="form-label">
                        Adresse email
                    </label>

                    <input
                            type="email"
                            id="username"
                            name="_username"
                            value="{{ last_username }}"
                            class="form-control"
                            autocomplete="email"
                            required
                            autofocus
                    >
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">
                        Mot de passe
                    </label>

                    <div data-controller="password-visibility" class="password-field">
                        <input
                                type="password"
                                id="password"
                                name="_password"
                                class="form-control"
                                autocomplete="current-password"
                                required
                                data-password-visibility-target="input"
                        >

                        <button
                                type="button"
                                class="password-field__toggle"
                                data-action="click->password-visibility#toggle"
                                aria-label="Afficher le mot de passe"
                                title="Afficher le mot de passe"
                        >
                            <i
                                    class="fa-solid fa-eye-slash"
                                    data-password-visibility-target="icon"
                            ></i>
                        </button>
                    </div>
                </div>

                <div class="form-check mb-4">
                    <input
                            type="checkbox"
                            id="remember_me"
                            name="_remember_me"
                            class="form-check-input"
                    >

                    <label class="form-check-label" for="remember_me">
                        Se souvenir de moi
                    </label>
                </div>

                <input
                        type="hidden"
                        name="_csrf_token"
                        value="{{ csrf_token('authenticate') }}"
                >

                <button type="submit" class="btn btn-primary w-100 login-submit">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>
                    Connexion
                </button>
            </form>

            <div class="login-footer">
                Pas encore de compte ? <a href="{{ path('app_register') }}">S'inscrire</a>
            </div>

            <div class="login-footer">
                Mot de passe oublié ? <a href="{{ path('app_forgot_password_request') }}">Réinitialiser</a>
            </div>

            <div class="login-footer">
                Administration © {{ 'now'|date('Y') }}
            </div>
        </div>
    </div>
{% endblock %}
