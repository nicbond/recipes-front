<button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#modalCannotDelete-{{ id }}">
    {% if icon is defined %}
        <i class="fas fa-trash-alt"></i>
    {% else %}
        Supprimer
    {% endif %}
</button>

<div class="modal fade" id="modalCannotDelete-{{ id }}" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">🚫 Suppression impossible</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <p>{{ warning }} <strong>{{ name }}</strong> {{ reason }}</p>
                <ul>
                    {% for recipe in recipes %}
                        <li>{{ recipe.title }}</li>
                    {% endfor %}
                </ul>
                <p class="text-muted">{{ message }}</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>
